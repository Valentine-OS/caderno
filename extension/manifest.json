{
  "manifest_version": 3,
  "name": "caderno.",
  "version": "1.3.0",
  "description": "Registra no caderno o que foi concluído: a página aberta vira uma entrada do feed.json.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.github.com/*"],
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Registrar no caderno",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png"
    }
  }
}
